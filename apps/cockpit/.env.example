# Backend reverse-proxy target per [[cockpit/auth-surface-mount]] (V3).
# next.config.ts async rewrites() proxy /api/auth/:path* and /v1/:path* to this URL,
# so the browser sees first-party requests (no CORS, no SameSite=None complexity).
#
# - Production: set on Vercel project env, e.g. https://api.bokchoy.com
# - Preview: set on Vercel preview env, e.g. https://api-staging.bokchoy.com
# - Local dev: http://localhost:3000 (backend Hono default port). Cockpit
#   itself runs on port 3001 (see `dev` script in package.json) to avoid an
#   EADDRINUSE collision when both servers run in parallel via `bun run dev`.
BOKCHOY_BACKEND_URL=http://localhost:3000
