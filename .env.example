# BokChoy local dev — values match compose.yml + [[local-docker]] init scripts.
# Copy to .env (gitignored) and adjust as needed.

# Backend runtime: connects as bokchoy_app (no SUPERUSER, no BYPASSRLS — RLS applies).
DATABASE_URL="postgresql://bokchoy_app:postgres@localhost:5433/postgres"

# drizzle-kit migrations: connects as postgres (BYPASSRLS, CREATEDB, CREATEROLE — DDL privileged).
# Per [[backend-stack]] cascade-6: direct port 5432, NOT pooled.
DATABASE_MIGRATION_URL="postgresql://postgres:postgres@localhost:5433/postgres"

# API-key HMAC signing secret per [[wallet-http-contract]] slice 8.1a.
# Backend HMACs the secret half of `bk_<env>_<32-hex>` Bearer tokens against this
# value and constant-time-compares the digest with `api_keys.key_hash`.
# Generate prod values via `openssl rand -hex 32`. Rotation runbook is owed (carry).
BOKCHOY_API_KEY_HMAC_SECRET="dev-only-test-secret-do-not-use-in-prod"

# OTel exporter endpoint per [[wallet-http-contract]] slice 8.1b + [[otel-stack-research]] F4.
# Unset → ConsoleSpanExporter (dev default). Honeycomb in prod:
#   OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io/v1/traces"
#   OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=<team-key>"
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
